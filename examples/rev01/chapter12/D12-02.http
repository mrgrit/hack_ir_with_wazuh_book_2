GET wazuh-alerts-*/_search
{
  "size": 0, "track_total_hits": true,
  "query": {"bool": {"filter": [
    {"term": {"synthetic.flag": true}},
    {"range": {"timestamp": {
      "gte": "2026-08-01T00:00:00+09:00",
      "lt": "2026-11-01T00:00:00+09:00"
    }}}
  ]}},
  "aggs": {
    "first": {"min": {"field": "timestamp"}},
    "last": {"max": {"field": "timestamp"}}
  }
}
