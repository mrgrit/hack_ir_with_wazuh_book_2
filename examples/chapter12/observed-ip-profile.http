GET wazuh-alerts-*/_search
{
  "size": 0, "track_total_hits": true,
  "query": {"bool": {"filter": [
    {"range": {"timestamp": {
      "gte": "2026-11-02T00:00:00+09:00",
      "lt": "2026-11-04T00:00:00+09:00"
    }}},
    {"bool": {"minimum_should_match": 1,
      "should": [
        {"term": {"data.srcip":
          "192.168.0.108"}},
        {"term": {"data.src_ip":
          "192.168.0.108"}}
      ]}}
  ]}},
  "aggs": {
    "max_level": {"max": {
      "field": "rule.level"}},
    "sensors": {"terms": {
      "field": "agent.name", "size": 50}},
    "rules": {"terms": {
      "field": "rule.id", "size": 100}},
    "level_5_or_higher": {"filter": {
      "range": {"rule.level": {"gte": 5}}}},
    "days": {"date_histogram": {
      "field": "timestamp",
      "calendar_interval": "day",
      "time_zone": "Asia/Seoul",
      "min_doc_count": 1}}
  }
}
